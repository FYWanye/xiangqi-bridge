{
  "name": "xiangqi-bridge",
  "version": "2.1.0",
  "description": "象棋 AI 桥接工具：本地 Web 控制台，自动读取 game.hullqin.cn 棋谱 → xiangqiai.com (Pikafish) 分析 → 自动落子",
  "type": "module",
  "scripts": {
    "start": "node scripts/gen-hooks.mjs && node server.js",
    "start:no-open": "node scripts/gen-hooks.mjs && node server.js --no-open",
    "cli": "node scripts/gen-hooks.mjs && node src/bridge.js",
    "test": "node test/fen-utils.test.mjs",
    "test:e2e": "node test/regression-fastpath.mjs",
    "gen:hooks": "node scripts/gen-hooks.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "postinstall": "node scripts/gen-hooks.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.65.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
